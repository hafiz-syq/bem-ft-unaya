# Build & runtime artifacts
node_modules/

# Environment files (contain secrets)
.env
.env.*.local
# Varian env produksi backend juga memuat kredensial; simpan di dashboard
# hosting, bukan di repo. Contoh env tetap dilacak sebagai dokumentasi.
backend/.env.*
!backend/.env.example

# Varian env frontend diabaikan juga, termasuk .env.production berikutnya.
# Dua berkas yang tetap dilacak sengaja dikecualikan karena isinya bukan
# rahasia: .env.example sebagai dokumentasi, dan .env.production karena build
# Vercel membacanya (VITE_API_URL=/api). Nilai VITE_* memang menempel ke
# bundle publik, jadi tidak pernah layak dianggap rahasia. Job "keamanan" di
# .github/workflows/uji-akses.yml memaksa semua env ter-track hanya berisi
# kunci VITE_*, jadi pengecualian baru tidak bisa dipakai diam-diam.
frontend/.env.*
!frontend/.env.example
!frontend/.env.production

# Vite dev & build output
frontend/dist/
frontend/.vite/

# Hasil kompilasi backend dibuat ulang saat build (lokal/Vercel).
backend/dist/

# OS files
.DS_Store
Thumbs.db

# Log proses (dev/server), termasuk log backup.
*.log

# Dump database (berisi data pribadi & hash password) — jangan masuk repo.
# Berkas yang sudah terlacak tetap perlu dikeluarkan dengan `git rm --cached`.
backups/
*.sql.gz
*.sql.zip
# Dump SQL manual di akar repo. Sengaja tidak memakai `*.sql` supaya migrasi
# Prisma di backend/prisma/migrations tetap bisa ditambahkan ke repo.
/*.sql

# Folder setelan lokal Vercel CLI (simpan di mesin, bukan repo).
.vercel/

# Berkas unggahan pengguna (foto, lampiran tiket) tidak boleh masuk repo.
# Hanya penanda folder yang dilacak supaya direktori tetap ada setelah clone.
backend/uploads/*
!backend/uploads/.gitkeep

# Berkas data sementara (hasil ekspor/impor, PDF kerjaan) — sama seperti
# uploads: isinya milik pengguna, bukan bagian dari kode.
backend/data/

# Cache pengetahuan Repo Wiki yang dibuat Qoder di mesin ini — artefak alat,
# bukan sumber proyek, dan isinya berubah sendiri saat indeks diperbarui.
.qoder/

# Skrip sekali-pakai (cek kolom, assert host DB, set password staging). Sering
# memuat kredensial uji dan tidak seharusnya masuk riwayat, jadi pola ini yang
# menahannya — termasuk saat `git add -A`.
*.tmp.cjs
