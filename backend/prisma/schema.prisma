datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

enum Role {
  MAHASISWA
  PENGURUS
  PENGURUS_DPM
  PENGURUS_BEM
  PENGURUS_SISTEM_INFORMASI
  PENGURUS_TEKNIK_MESIN
  PENGURUS_TEKNIK_SIPIL
  ADMIN
  // Pengelola web: satu tingkat di atas ADMIN. Akun ini yang boleh mengubah
  // role akun ADMIN lain, sehingga sistem tidak bisa terkunci karena seluruh
  // admin diturunkan/dinonaktifkan. Tidak pernah bisa dinonaktifkan.
  SUPERADMIN
}

/// Tujuan organisasi sebuah tiket.
/// - ASPIRASI hanya boleh masuk ke BEM.
/// - KELUHAN boleh diarahkan ke DPM atau ke salah satu himpunan prodi.
/// Nilai enum ini sengaja memakai nama organisasi, bukan id, supaya
/// pencocokan hak baca tidak bergantung pada baris tabel Organization
/// yang bisa saja dihapus/diubah admin.
enum TicketTarget {
  DPM
  BEM
  SISTEM_INFORMASI
  TEKNIK_MESIN
  TEKNIK_SIPIL
}

enum DataChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModerationStatus {
  PENDING_MODERATION
  PUBLISHED
  REJECTED
}

enum PublicCommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  DIKIRIM
  DITINJAU
  DIPROSES
  SELESAI
  DITOLAK
}

/// Tingkat urgensi tiket. Dipakai menghitung tenggat respons pertama (SLA)
/// dan mengurutkan antrean pengurus di halaman Layanan Tiket.
enum TicketPriority {
  RENDAH
  NORMAL
  TINGGI
  MENDESAK
}

model User {
  id                   String              @id @default(uuid())
  nim                  String              @unique
  password_hash        String
  role                 Role                @default(MAHASISWA)
  first_login          Boolean             @default(true)
  isActive             Boolean             @default(true)

  // Email akun untuk SEMUA role. Diperlukan karena akun ADMIN/SUPERADMIN tidak
  // punya StudentProfile, sehingga tanpa kolom ini mereka tidak punya alamat
  // email sama sekali dan fitur lupa password tidak bisa menjangkaunya.
  // Untuk mahasiswa/pengurus nilainya disalin dari StudentProfile.email.
  email                String?             @unique

  // --- Siklus hidup akun mahasiswa ---
  // deactivatedAt dipakai job otomatis untuk menghitung "sudah nonaktif 1 tahun".
  // deactivationType membedakan nonaktif MANUAL (oleh admin/pengurus) dengan AUTO
  // (habis masa studi 5 tahun); hanya yang AUTO yang boleh dihapus otomatis.
  deactivatedAt        DateTime?
  deactivationType     String?

  // --- Perpanjangan & tenggat hapus yang diatur admin ---
  // tenggatHapus: kapan akun nonaktif-otomatis dihapus permanen. Kosong berarti
  // mengikuti aturan bawaan (deactivatedAt + tenggat 1 tahun). Admin boleh
  // menggeser tanggal ini untuk menunda penghapusan tanpa mengaktifkan akun.
  tenggatHapus         DateTime?
  // perpanjanganHingga: akhir masa perpanjangan studi. Selama tanggal ini belum
  // lewat, akun TIDAK dinonaktifkan otomatis walau angkatannya sudah lewat 5
  // tahun. Kosong berarti tidak ada perpanjangan.
  perpanjanganHingga   DateTime?

  // Foto profil berlaku untuk SEMUA role (termasuk ADMIN yang tidak punya
  // StudentProfile), sehingga disimpan di tabel User, bukan hanya di profil.
  foto                 String?

  // --- Tempat sampah 30 hari ---
  // Penghapusan oleh superadmin tidak langsung memusnahkan data: akun
  // disembunyikan dari semua daftar dan tidak bisa login, lalu bisa dipulihkan
  // dalam 30 hari. Job berkala memusnahkannya setelah tenggat itu lewat.
  deletedAt            DateTime?
  deletedById          String?
  deletionReason       String?             @db.Text
  
  // --- Perangkat & sesi (kunci perangkat) ---
  deviceId             String?            @db.VarChar(64)
  deviceLabel          String?            @db.VarChar(160)
  deviceBoundAt        DateTime?
  pendingDeviceId      String?            @db.VarChar(64)
  pendingDeviceLabel   String?            @db.VarChar(160)
  pendingDeviceAt      DateTime?
  sessionVersion       Int                @default(0)

  // Berapa perangkat yang boleh aktif bersamaan untuk akun ini.
  // 10 = batas bawaan (HP, tablet, laptop, dan perangkat lain). Diatur admin
  // dari halaman Perangkat & Sesi bila akun perlu dibatasi lebih ketat.
  maxDevices           Int                @default(10)
  // Perangkat ke-2 dan seterusnya. Perangkat pertama tetap di kolom deviceId
  // di atas supaya data lama tidak perlu dimigrasikan.
  devices              UserDevice[]
  
  profile              StudentProfile?
  positions            Position[]
  
  ticketsSent          Ticket[]            @relation("TicketSender")
  ticketsModerated     Ticket[]            @relation("TicketModerator")
  ticketReplies        TicketReply[]       @relation("TicketReplyAuthor")

  notifications        Notification[]

  contents             Content[]

  agendas              Agenda[]
  galleries            Gallery[]
  
  assignmentsReceived  TicketAssignment[]  @relation("Assignee")
  assignmentsGiven     TicketAssignment[]  @relation("Assigner")
  emailVerification    EmailVerification?
  
  dataRequests         DataChangeRequest[] @relation("DataOwner")
  dataRequestsReviewed DataChangeRequest[] @relation("DataReviewer")
  
  commentsModerated    PublicComment[]     @relation("CommentModerator")
  commentReplies       PublicCommentReply[] @relation("CommentReplier")
  auditLogs            AuditLog[]          @relation("AuditActor")

  // Komentar galeri (fitur komentar publik pada halaman Galeri).
  galleryComments      GalleryComment[]    @relation("GalleryCommentAuthor")
  galleryCommentsModerated GalleryComment[] @relation("GalleryCommentModerator")

  // Fitur lanjutan: notifikasi browser, pengumuman, template balasan tiket,
  // dan arsip surat/proposal.
  pushSubscriptions    PushSubscription[]
  announcementReads    AnnouncementRead[]
  announcementsCreated Announcement[]      @relation("AnnouncementCreator")
  ticketTemplates      TicketTemplate[]    @relation("TemplateCreator")
  documentsCreated     Document[]          @relation("DocumentCreator")
  documentsApproved    Document[]          @relation("DocumentApprover")

  // Satu permintaan reset password aktif per akun.
  passwordReset        PasswordReset?
  presence             UserPresence?
  chatMessages         ChatMessage[]
  
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([deviceId])
  @@index([deletedAt])
}

/// Perangkat tambahan yang diizinkan aktif bersamaan untuk satu akun.
/// Perangkat utama tetap disimpan di kolom User.deviceId (data lama), sehingga
/// hanya perangkat ke-2 dan seterusnya yang masuk tabel ini.
model UserDevice {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String   @db.VarChar(64)
  label      String?  @db.VarChar(160)
  boundAt    DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([deviceId])
}

model StudentProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  nama          String
  nim           String   @unique
  program_studi String
  email         String?
  no_hp         String?
  foto          String?

  // Terisi hanya setelah pengguna memasukkan kode verifikasi yang benar.
  // Selama email ada tapi belum terverifikasi, pengguna ditahan di halaman verifikasi.
  email_verified_at DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Kode verifikasi email disimpan di tabel TERPISAH, bukan di StudentProfile.
/// Alasannya: objek StudentProfile dikirim utuh ke klien di banyak endpoint
/// (profil, audit, CMS, posisi, students, tiket, data-request). Kalau hash kode
/// disimpan di sana, kode verifikasi ikut bocor. Tabel ini tidak pernah
/// disertakan pada query-query tersebut, jadi kodenya aman secara desain.
model EmailVerification {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code_hash    String? // kode 6 digit dalam bentuk hash, bukan teks asli
  expires_at   DateTime?
  attempts     Int       @default(0) // percobaan salah; kode hangus setelah batas
  last_sent_at DateTime? // untuk membatasi frekuensi kirim ulang
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model DataChangeRequest {
  id           String                  @id @default(uuid())
  userId       String
  user         User                    @relation("DataOwner", fields: [userId], references: [id])
  requestData  Json
  reason       String?                 @db.Text
  status       DataChangeRequestStatus @default(PENDING)
  reviewedById String?
  reviewer     User?                   @relation("DataReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
}

model Organization {
  id            String         @id @default(uuid())
  name          String
  /// Tipe organisasi untuk penjenjangan arsip surat.
  /// HIMPUNAN (tingkat 1) < BEM (2) < DPM (3): surat sebuah organisasi hanya
  /// terlihat oleh pimpinan inti organisasi itu sendiri dan tingkat di atasnya.
  kind          String         @default("HIMPUNAN") @db.VarChar(20)
  isActive      Boolean        @default(true)
  departments   Department[]
  positionSlots PositionSlot[]
  documents     Document[]
}

model Department {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  name           String
  isActive       Boolean        @default(true)
  positionSlots  PositionSlot[]
}

model PositionSlot {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  title          String
  isActive       Boolean      @default(true)
  positions      Position[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, departmentId, title])
}

model Position {
  id             String       @id @default(uuid())
  positionSlotId String
  positionSlot   PositionSlot @relation(fields: [positionSlotId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  isActive       Boolean      @default(true)
  startDate      DateTime     @default(now())
  endDate        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Ticket {
  id               String             @id @default(uuid())
  ticket_no        String             @unique
  type             String
  // Organisasi tujuan tiket. Null untuk data lama sebelum fitur ini ada.
  targetOrganization TicketTarget?
  senderId         String
  sender           User               @relation("TicketSender", fields: [senderId], references: [id])
  category         String
  title            String
  content          String             @db.Text
  moderationStatus ModerationStatus   @default(PENDING_MODERATION)
  status           TicketStatus       @default(DIKIRIM)
  moderatedById    String?
  moderator        User?              @relation("TicketModerator", fields: [moderatedById], references: [id])
  moderatedAt      DateTime?
  // --- Layanan tiket: prioritas, SLA respons pertama, dan penilaian ---
  priority         TicketPriority     @default(NORMAL)
  // Diisi saat pengurus/admin mengirim balasan pertama. Selisihnya dengan
  // createdAt adalah waktu respons yang dipakai indikator SLA.
  firstResponseAt  DateTime?
  resolvedAt       DateTime?
  // Umpan balik pengirim setelah tiket selesai (1–5). Satu nilai per tiket.
  rating           Int?
  ratingComment    String?            @db.Text
  ratedAt          DateTime?
  assignments      TicketAssignment[]
  replies          TicketReply[]
  attachments      Attachment[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status, priority, createdAt])
  // EXPLAIN: rata-rata jam respons (jendela 2000 tiket terbaru) menyaring createdAt
  // tanpa filter status; sebelumnya query itu memindai seluruh tabel (24.888 baris).
  // Bukan lagi untuk hitung nomor tiket harian: penomoran kini MAX pada ticket_no.
  @@index([createdAt])
}

model TicketAssignment {
  id          String    @id @default(uuid())
  ticketId    String
  ticket      Ticket    @relation(fields: [ticketId], references: [id])
  assigneeId  String
  assignee    User      @relation("Assignee", fields: [assigneeId], references: [id])
  assignerId  String
  assigner    User      @relation("Assigner", fields: [assignerId], references: [id])
  isActive    Boolean   @default(true)
  assignedAt  DateTime  @default(now())
  completedAt DateTime?
}

model TicketReply {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  authorId  String
  author    User     @relation("TicketReplyAuthor", fields: [authorId], references: [id])
  content   String   @db.Text
  createdAt DateTime @default(now())
}

model Attachment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  filename  String
  url       String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

model PublicComment {
  id            String              @id @default(uuid())
  nama          String
  asal_kampus   String
  email         String
  no_hp         String
  content       String              @db.Text
  status        PublicCommentStatus @default(PENDING)
  moderatedById String?
  moderator     User?               @relation("CommentModerator", fields: [moderatedById], references: [id])
  moderatedAt   DateTime?
  createdAt     DateTime            @default(now())
  // Utas balasan resmi dari admin/pengurus.
  replies       PublicCommentReply[]

  // --- Moderasi komunitas & tempat sampah ---
  // isFlagged menandai pesan yang dilaporkan pengunjung atau mengandung kata
  // yang tidak pantas. Pesan tetap tersimpan sampai admin memutuskan.
  isFlagged      Boolean   @default(false)
  flagReason     String?   @db.Text
  reportedCount  Int       @default(0)
  lastReportedAt DateTime?
  deletedAt      DateTime?
  deletedById    String?

  // Mempercepat daftar komentar yang tayang di halaman depan (hanya APPROVED).
  @@index([status, createdAt])
  // EXPLAIN: tren komentar per bulan menyaring rentang createdAt saja; tanpa
  // indeks ini query-nya memindai seluruh indeks status (39.780 baris).
  @@index([createdAt])
  @@index([isFlagged, createdAt])
  @@index([deletedAt])
}

/// Balasan resmi admin/pengurus atas sebuah komentar publik.
/// Dibuat sebagai tabel sendiri, bukan kolom di PublicComment, supaya beberapa
/// pengurus bisa menjawab berurutan dalam satu utas — sama seperti balasan tiket.
model PublicCommentReply {
  id        String        @id @default(uuid())
  commentId String
  comment   PublicComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation("CommentReplier", fields: [authorId], references: [id])
  content   String        @db.Text
  createdAt DateTime      @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  // actorId boleh kosong: peristiwa yang datang dari luar (mis. permintaan dari
  // origin web yang ditolak) tidak punya pelaku manusia, dan pemeriksaan
  // otomatis pun dicatat tanpa pengguna. actor = null berarti "Sistem".
  actorId     String?
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id])
  action      String
  entityType  String
  entityId    String?
  description String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  // Mempercepat ringkasan per jenis aksi pada rentang waktu tertentu
  // (dipakai ringkasan keamanan di dashboard admin).
  @@index([action, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Content {
  id        String   @id @default(uuid())
  type      String   // Bisa berisi: 'BERITA', 'ARTIKEL', atau 'PROGRAM'
  title     String
  content   String   @db.Text
  status    String   @default("PUBLISHED") // 'DRAFT' atau 'PUBLISHED'
  image     String?
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // EXPLAIN: daftar konten (dengan atau tanpa filter type) semula full scan
  // 5994 baris + filesort; indeks ini menghilangkan penyortirannya.
  @@index([status, createdAt])
}

model Agenda {
  id               String   @id @default(uuid())
  title            String
  description      String   @db.Text
  date             DateTime
  endDate          DateTime?
  time             String
  location         String
  status           String   @default("UPCOMING") // 'UPCOMING' atau 'SELESAI'
  color            String   @default("#F59E0B") @db.VarChar(7)
  registrationLink String?
  // Tautan khusus postingan media sosial (Instagram/TikTok/Facebook) untuk agenda ini.
  socialMediaLink  String?
  authorId         String
  author           User     @relation(fields: [authorId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([date])
}

model Gallery {
  id         String   @id @default(uuid())
  title      String
  category   String   // 'FOTO' atau 'VIDEO' atau 'DOKUMENTASI'
  // url tetap dipertahankan sebagai COVER (foto pertama) agar seluruh
  // tampilan lama yang cuma membaca satu gambar tetap jalan.
  url        String
  activity   String?
  year       Int
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id])  // Satu postingan galeri boleh memuat banyak foto (carousel).
  images     GalleryImage[]
  comments   GalleryComment[]
  createdAt  DateTime      @default(now())
}

/// Satu foto di dalam sebuah postingan galeri.
model GalleryImage {
  id        String   @id @default(uuid())
  galleryId String
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

/// Riwayat demisioner (pengurus lama) DPM & BEM Teknik.
model Demisioner {
  id           String   @id @default(uuid())
  organization String // 'DPM' atau 'BEM' (bebas teks agar admin fleksibel)
  nama         String
  nim          String
  jabatan      String?
  periode      String // contoh: '2022/2023'
  foto         String?
  description  String?  @db.Text // sejarah singkat / pesan demisioner
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // EXPLAIN: daftar demisioner (filter organization + urut organization,
  // periode, nama) semula full scan + filesort. Periode diminta DESC; MySQL 8
  // masih menyortir sisa baris yang cocok, jadi indeks ini memotong pembacaan
  // tabel, bukan menghilangkan filesort.
  @@index([organization, periode, nama])
}

/// Pengaturan teks situs yang bisa diubah admin setiap pergantian kepengurusan.
/// Dipakai untuk visi & misi BEM (dan teks lain ke depannya).
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/// Komentar pengunjung pada satu postingan galeri.
/// Dipisah dari PublicComment (buku tamu) supaya komentar galeri tidak pernah
/// tercampur dengan pesan buku tamu yang sudah tayang, dan ikut terhapus
/// otomatis saat postingan galerinya dihapus.
model GalleryComment {
  id            String              @id @default(uuid())
  galleryId     String
  gallery       Gallery             @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  // Komentar boleh datang dari tamu tanpa akun, jadi penulis akun opsional.
  // Salah satu dari authorId / guestName selalu terisi (dijaga controller).
  authorId      String?
  author        User?               @relation("GalleryCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  guestName     String?
  // Jejak pengirim tamu (untuk moderasi): alamat IP & perangkat.
  guestIp       String?
  guestUserAgent String?
  content       String              @db.Text
  // Default PENDING: komentar tampil setelah disetujui admin/pengurus.
  status        PublicCommentStatus @default(PENDING)
  moderatedById String?
  moderator     User?               @relation("GalleryCommentModerator", fields: [moderatedById], references: [id])
  moderatedAt   DateTime?
  createdAt     DateTime            @default(now())

  @@index([galleryId, status, createdAt])
  @@index([guestIp, createdAt])
}

/// Kode OTP & token sekali pakai untuk fitur lupa password.
/// Token disimpan sebagai hash SHA-256 (deterministik) supaya barisnya bisa
/// dicari langsung dari tautan; kode OTP disimpan sebagai hash bcrypt karena
/// selalu dicocokkan untuk satu pengguna yang sudah diketahui.
model PasswordReset {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otp_hash         String?
  otp_expires_at   DateTime?
  token_hash       String?   @unique
  token_expires_at DateTime?
  attempts         Int       @default(0)
  last_sent_at     DateTime?
  used_at          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Heartbeat sesi agar pengguna yang sedang membuka situs tampak aktif.
model UserPresence {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime @default(now())

  @@index([lastSeenAt])
}

/// Ruang forum percakapan yang dapat dibuat pengurus BEM/DPM dan admin.
model ChatRoom {
  id          String        @id @default(uuid())
  name        String        @db.VarChar(100)
  description String?       @db.VarChar(500)
  createdById String
  createdAt   DateTime      @default(now())
  isOpen      Boolean       @default(true)
  messages    ChatMessage[]

  @@index([isOpen, createdAt])
}

model ChatMessage {
  id        String   @id @default(uuid())
  roomId    String
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

/// Pertanyaan yang sering diajukan (halaman FAQ dashboard).
model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Template balasan cepat untuk pengurus di halaman Layanan Tiket.
model TicketTemplate {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(120)
  content     String   @db.Text
  createdById String
  createdBy   User     @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: Cascade)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Pengumuman tersegmentasi: role, angkatan, atau organisasi tertentu.
/// Kolom organisasi sengaja berupa id biasa (bukan relasi) supaya pengumuman
/// tetap terbaca walau organisasinya kelak diganti nama.
enum AnnouncementAudience {
  SEMUA
  ROLE
  ANGKATAN
  ORGANISASI
}

model Announcement {
  id                     String               @id @default(uuid())
  title                  String               @db.VarChar(180)
  content                String               @db.Text
  audience               AnnouncementAudience @default(SEMUA)
  audienceRole           Role?
  audienceAngkatan       Int?
  audienceOrganizationId String?
  isPublished            Boolean              @default(true)
  createdById            String
  createdBy              User                 @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Cascade)
  reads                  AnnouncementRead[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([isPublished, createdAt])
}

/// Satu baris per pengguna yang sudah membuka pengumuman. Dipakai untuk
/// menghitung jumlah pembaca di halaman pengelolaan.
model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId, readAt])
}

/// Arsip surat & proposal kepengurusan dengan alur status sederhana.
/// type: SURAT | PROPOSAL
/// status: DRAFT | DIAJUKAN | DISETUJUI | DITOLAK | DIARSIPKAN
/// direction: MASUK (diterima) | KELUAR (diterbitkan)
model Document {
  id           String    @id @default(uuid())
  type         String    @db.VarChar(20)
  number       String    @db.VarChar(80)
  title        String    @db.VarChar(200)
  description  String?   @db.Text
  status       String    @default("DRAFT") @db.VarChar(20)

  // Organisasi yang diberi/menerbitkan surat. Dipakai sebagai penyaring utama
  // arsip: pimpinan tiap organisasi memilah surat berdasarkan organisasinya.
  // Null berarti belum ditentukan (data lama sebelum kolom ini ada).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Arah surat. Hanya admin/superadmin yang boleh memilah dan mengubahnya;
  // pengurus lain melihat seluruh arsip tanpa pemilah arah.
  direction    String    @default("KELUAR") @db.VarChar(10)

  fileUrl      String?
  fileName     String?
  note         String?   @db.Text
  createdById  String
  createdBy    User      @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  approvedById String?
  approvedBy   User?     @relation("DocumentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([type, number])
  @@index([status, createdAt])
  @@index([organizationId, direction])
}

/// Langganan Web Push milik satu perangkat. Endpoint unik karena browser yang
/// sama tidak boleh didaftarkan dua kali.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Kesalahan server yang tidak terduga, dicatat agar bisa ditinjau admin dari
/// halaman Pemantauan tanpa bergantung pada log platform.
model ErrorLog {
  id         String    @id @default(uuid())
  message    String    @db.Text
  stack      String?   @db.Text
  method     String    @db.VarChar(10)
  path       String    @db.VarChar(500)
  statusCode Int       @default(500)
  userId     String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([resolvedAt, createdAt])
}