# ============================================================
#  Contoh konfigurasi backend.
#  Cara pakai: salin file ini menjadi ".env" lalu isi nilainya.
#  File ".env" yang berisi nilai asli TIDAK boleh di-commit.
#
#  Di Hostinger, lebih aman mengisi nilai ini lewat
#  hPanel -> Advanced -> Node.js -> Environment Variables.
#  Jangan pakai keduanya sekaligus: nilai hPanel menang atas .env.
# ============================================================

# --- Server (lokal) ---
# Hostinger menyuntikkan PORT sendiri; biarkan baris ini sebagai cadangan lokal.
PORT=3000
NODE_ENV=development

# --- Server (Hostinger) ---
# Salin nilai berikut ke hPanel -> Node.js -> Environment Variables.
# NODE_ENV=production
# TRUST_PROXY=1
# SERVE_FRONTEND=1
# FRONTEND_DIST=/home/uXXXXXX/domains/domain.com/app/frontend/dist
# UPLOAD_DIR=/home/uXXXXXX/domains/domain.com/uploads
#
# TRUST_PROXY membuat IP asli pengunjung dibaca dari X-Forwarded-For dan cookie
# Secure dikenali dari X-Forwarded-Proto. UPLOAD_DIR harus di luar folder
# aplikasi supaya foto/cover/lampiran tidak hilang saat deploy ulang.

# SameSite cookie sesi: lax (default), strict, atau none.
# Pakai "none" HANYA bila frontend dan API berada di situs berbeda.
# Dengan satu domain Hostinger (SPA + API), biarkan lax.
# COOKIE_SAME_SITE=none

# Origin yang boleh memanggil API (CORS).
# Alamat lokal/LAN sudah otomatis diizinkan; tulis HANYA origin publik.
FRONTEND_URL=http://localhost:5173
# Hostinger: FRONTEND_URL=https://domain-anda.com
# FRONTEND_URLS=https://domain-anda.com,https://www.domain-anda.com

# --- Job terjadwal ---
# Di Hostinger set RUN_STARTUP_JOBS=0: proses Node bisa berhenti saat tidak ada
# trafik, dan job yang berjalan di setiap cold start bisa mengirim email
# peringatan berkali-kali. Job dijalankan cron hPanel ke POST /api/internal/cron
# (lihat DEPLOY.md).
# RUN_STARTUP_JOBS=0

# Wajib diisi agar endpoint cron bisa dipakai. Buat teks acak 64 karakter:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=teks-acak-64-karakter

# Penerima email ringkasan perpanjangan masa studi.
# ADMIN_EMAIL=admin@domain-anda.com

# --- Database (MySQL) ---
# Lokal (Laragon/MySQL):
DATABASE_URL="mysql://root:PASSWORD@localhost:3306/bem_ft_unaya?connection_limit=5&pool_timeout=20"
# Hostinger: host biasanya localhost, nama database & user berawalan uXXXXXX_.
# `connection_limit` 5 cukup untuk satu proses API (batas per user Premium 50).
# DATABASE_URL="mysql://uXXXXXX_bemft:PASSWORD@localhost:3306/uXXXXXX_bemft?connection_limit=5&pool_timeout=20"
#
# Aiven MySQL (Vercel): salin host, port, user, dan nama database dari
# dashboard Aiven. Password harus di-URL-encode (mis. @ menjadi %40).
# Gunakan sslaccept=strict (parameter Prisma), bukan ssl-mode=REQUIRED.
# Aiven memakai CA sendiri. backend/src/lib/prisma.ts sudah menyisipkan CA
# proyek ini secara otomatis saat host berakhiran aivencloud.com, jadi
# sslrootcert tidak perlu diisi manual kecuali memakai CA lain.
# Tanpa CA, sslaccept=strict gagal dengan P1011 (certificate not trusted).
# Untuk perintah Prisma CLI langsung ke Aiven, isi sslrootcert dengan path ca.pem.
# DATABASE_URL="mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslaccept=strict&sslrootcert=PATH_KE_ca.pem&connection_limit=5&pool_timeout=20"

# --- Autentikasi ---
# Gunakan teks acak yang panjang dan berbeda untuk setiap lingkungan.
JWT_SECRET=ganti-dengan-kunci-rahasia-anda

# Cookie sesi ditandai "Secure" hanya jika permintaannya benar-benar HTTPS,
# dibaca dari koneksi langsung atau header X-Forwarded-Proto. Pastikan SSL
# Hostinger aktif dan TRUST_PROXY=1.

# --- Batas ukuran lampiran (byte) ---
MAX_ATTACHMENT_SIZE=5242880

# --- Cloudinary (penyimpanan foto profil) ---
# Foto profil diunggah ke Cloudinary dan database hanya menyimpan URL-nya
# (https://res.cloudinary.com/...). Ini wajib untuk Vercel: filesystem serverless
# bersifat sementara, jadi berkas yang ditulis ke disk hilang saat instance
# dingin atau deploy ulang (foto profil tampak "menghilang").
#
# Ambil ketiga nilai di dashboard Cloudinary -> Settings -> API Keys.
# Di Vercel, tambahkan sebagai Environment Variable project (Production), karena
# berkas .env tidak ikut ter-commit.
CLOUDINARY_CLOUD_NAME=nama-cloud-anda
CLOUDINARY_API_KEY=api-key-anda
CLOUDINARY_API_SECRET=api-secret-anda

# --- Email / SMTP ---
# Dipakai untuk notifikasi tiket dan pengiriman kode verifikasi email.
# Hostinger membuka port 465/587. Dua pilihan yang umum:
#   Gmail     : smtp.gmail.com, 587, SMTP_SECURE=false, pakai App Password
#   Hostinger : smtp.hostinger.com, 465, SMTP_SECURE=true
# Uji koneksi dari server sebelum menyalahkan kode:
#   openssl s_client -starttls smtp -connect smtp.gmail.com:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alamat-email-anda@gmail.com
SMTP_PASS=ganti-dengan-app-password-gmail-anda
SMTP_FROM=BEM-FT UNAYA
