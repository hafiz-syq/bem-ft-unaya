# ============================================================
#  Contoh konfigurasi backend.
#  Cara pakai: salin file ini menjadi ".env" lalu isi nilainya.
#  File ".env" yang berisi nilai asli TIDAK boleh di-commit.
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Database (MySQL) ---
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/bem_ft_unaya"

# --- Autentikasi ---
# Gunakan teks acak yang panjang dan berbeda untuk setiap lingkungan.
JWT_SECRET=ganti-dengan-kunci-rahasia-anda

# --- Batas ukuran lampiran (byte) ---
MAX_ATTACHMENT_SIZE=5242880

# --- Email / SMTP ---
# Dipakai untuk notifikasi tiket dan pengiriman kode verifikasi email.
# Untuk Gmail, SMTP_PASS harus berupa "App Password", bukan password akun biasa.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alamat-email-anda@gmail.com
SMTP_PASS=ganti-dengan-app-password-gmail-anda
SMTP_FROM=BEM-FT UNAYA
