# ============================================================
#  Contoh konfigurasi backend.
#  Cara pakai: salin file ini menjadi ".env" lalu isi nilainya.
#  File ".env" yang berisi nilai asli TIDAK boleh di-commit.
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# Set ke 1 bila API berjalan di balik reverse proxy/load balancer (Nginx,
# Cloudflare, cPanel, dsb.). Nilai ini membuat IP asli pengunjung dibaca dari
# X-Forwarded-For, sehingga pembatas komentar tamu dan info asal pengirim di
# halaman moderasi tidak mencatat IP proxy.
# TRUST_PROXY=1

# Folder berkas unggahan. Kosong = backend/uploads.
# Di server produksi arahkan ke folder PERSISTEN (bukan filesystem container),
# mis. /var/lib/bem-ft/uploads, agar foto & lampiran tidak hilang saat deploy ulang.
# UPLOAD_DIR=/var/lib/bem-ft/uploads

# SameSite cookie sesi: lax (default), strict, atau none.
# Pakai "none" HANYA bila frontend dan API berada di situs berbeda (mis. Vercel
# *.vercel.app + API *.onrender.com). SameSite=None otomatis memaksa Secure,
# jadi API wajib diakses lewat HTTPS. Kalau frontend ada di app.domain dan API
# di api.domain (masih satu situs), biarkan lax.
# COOKIE_SAME_SITE=none

# Origin yang boleh memanggil API (CORS).
# Alamat lokal/LAN (localhost, 127.0.0.1, 10.x, 172.16-31.x, 192.168.x, ::1, dan
# IPv6 fc00::/7) sudah otomatis diizinkan tanpa ditulis di sini, sehingga aplikasi
# bisa langsung dibuka dari HP di jaringan kampus.
# Tulis di sini HANYA origin publik tambahan, mis. domain produksi.
# Beberapa origin dipisah koma, dan boleh juga memakai FRONTEND_URLS.
FRONTEND_URL=http://localhost:5173
# FRONTEND_URLS=https://bem-ft.unaya.ac.id,https://www.bem-ft.unaya.ac.id

# --- Database (MySQL) ---
# `connection_limit` membatasi jumlah koneksi dari satu proses API. Untuk satu
# instance cukup 10; naikkan perlahan bila metrik koneksi menunggu tinggi.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/bem_ft_unaya?connection_limit=10&pool_timeout=20"

# MySQL terkelola (mis. Aiven) mewajibkan TLS. Unduh CA certificate dari konsol
# penyedia, simpan di server (jangan di repo), lalu tambahkan parameternya:
# DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/bem_ft_unaya?sslcert=/etc/bem-ft/aiven-ca.pem&sslaccept=strict&connection_limit=5&pool_timeout=20"
# Satu node Aiven Free hanya memberi 76 koneksi; connection_limit=5 cukup untuk
# satu proses API dan menyisakan ruang untuk klien lain (Prisma Studio, dump).

# --- Autentikasi ---
# Gunakan teks acak yang panjang dan berbeda untuk setiap lingkungan.
JWT_SECRET=ganti-dengan-kunci-rahasia-anda

# Cookie sesi ditandai "Secure" hanya jika permintaannya benar-benar HTTPS,
# dibaca dari koneksi langsung atau header X-Forwarded-Proto.
# Kalau backend diletakkan di balik reverse proxy (Nginx/Apache) yang melakukan
# terminasi HTTPS, pastikan proxy tersebut mengirim header X-Forwarded-Proto: https,
# jika tidak cookie akan dikirim tanpa flag Secure.

# --- Batas ukuran lampiran (byte) ---
MAX_ATTACHMENT_SIZE=5242880

# --- Email / SMTP ---
# Dipakai untuk notifikasi tiket dan pengiriman kode verifikasi email.
# Untuk Gmail, SMTP_PASS harus berupa "App Password", bukan password akun biasa.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alamat-email-anda@gmail.com
SMTP_PASS=ganti-dengan-app-password-gmail-anda
SMTP_FROM=BEM-FT UNAYA
